{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"palette": [
				{
					"slug": "contrast",
					"color": "#24362B",
					"name": "Sage deep"
				},
				{
					"slug": "accent",
					"color": "#4B7556",
					"name": "Sage"
				},
				{
					"slug": "soft",
					"color": "#EEF4EE",
					"name": "Sage soft"
				},
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "muted",
					"color": "#4A5F50",
					"name": "Slate"
				},
				{
					"slug": "deep",
					"color": "#17241B",
					"name": "Sage night"
				},
				{
					"slug": "tint",
					"color": "#A9C9B0",
					"name": "Sage tint"
				},
				{
					"slug": "line",
					"color": "#D6E3D8",
					"name": "Sage line"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": [
								"file:./assets/fonts/dm-sans-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": [
								"file:./assets/fonts/dm-sans-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "fraunces",
					"name": "Fraunces",
					"fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "600 700",
							"src": [
								"file:./assets/fonts/fraunces-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "600 700",
							"src": [
								"file:./assets/fonts/fraunces-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "system",
					"name": "System sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.5rem, 1.2rem + 1.2vw, 2.375rem)"
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "clamp(2.25rem, 1.6rem + 2.8vw, 3.625rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "2",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "3",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "4",
					"size": "clamp(3rem, 2rem + 3vw, 5.25rem)"
				}
			]
		},
		"custom": {
			"radius": "3px",
			"fontDisplay": "var(--wp--preset--font-family--fraunces)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--dm-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.08",
					"letterSpacing": "-0.02em",
					"fontFamily": "var(--wp--preset--font-family--fraunces)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--contrast)",
						"offsetX": "0",
						"offsetY": "0",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "var(--wp--custom--radius)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--soft)"
				}
			}
		}
	}
}
